{
  "name": "Editorial - chatbot de publicacoes",
  "active": false,
  "nodes": [
    {
      "id": "chat-editorial",
      "name": "Chat editorial",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        0
      ],
      "parameters": {
        "public": false,
        "mode": "hostedChat",
        "authentication": "n8nUserAuth",
        "requireExecuteAccess": true,
        "availableInChat": false,
        "initialMessages": "Ola! Vamos criar sua publicacao. Qual e o assunto?",
        "options": {
          "responseMode": "lastNode",
          "title": "Assistente de publicacoes",
          "subtitle": "Prepare, revise e escolha suas redes",
          "allowFileUploads": false
        }
      },
      "webhookId": "editorial-social-chat"
    },
    {
      "id": "conversar-e-preparar",
      "name": "Conversar e preparar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://editorial:8080/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({session_id:$json.sessionId,message:$json.chatInput}) }}",
        "options": {
          "timeout": 90000
        }
      }
    },
    {
      "id": "tem-envios",
      "name": "Tem envios",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dispatch",
              "leftValue": "={{ $json.jobs.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "responder",
      "name": "Responder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        200
      ],
      "parameters": {
        "jsCode": "return [{json:{output:$input.first().json.output}}];"
      }
    },
    {
      "id": "preparar-envios",
      "name": "Preparar envios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "return $input.first().json.jobs.map(job=>({json:job}));"
      }
    },
    {
      "id": "chamar-publicador",
      "name": "Chamar publicador",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.workflow_id }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "reunir-resultados",
      "name": "Reunir resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const jobs=$('Preparar envios').all();const results=$input.all();if(jobs.length!==results.length) throw new Error('Numero inesperado de retornos; confira as execucoes antes de repetir');return [{json:{results:results.map((item,i)=>({job_id:jobs[i].json.job_id,result:item.json}))}}];"
      }
    },
    {
      "id": "registrar-resultados",
      "name": "Registrar resultados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://editorial:8080/results",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 90000
        }
      }
    }
  ],
  "connections": {
    "Chat editorial": {
      "main": [
        [
          {
            "node": "Conversar e preparar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conversar e preparar": {
      "main": [
        [
          {
            "node": "Tem envios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem envios": {
      "main": [
        [
          {
            "node": "Preparar envios",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar envios": {
      "main": [
        [
          {
            "node": "Chamar publicador",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chamar publicador": {
      "main": [
        [
          {
            "node": "Reunir resultados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reunir resultados": {
      "main": [
        [
          {
            "node": "Registrar resultados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registrar resultados": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Cuiaba",
    "saveManualExecutions": true
  },
  "pinData": {},
  "tags": []
}
