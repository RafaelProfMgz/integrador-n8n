{
  "name": "Manual - publicar no Instagram (formulario)",
  "active": false,
  "nodes": [
    {
      "id": "chat-editorial",
      "name": "Formulario de publicacao",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "parameters": {
        "authentication": "n8nUserAuth",
        "requireExecuteAccess": true,
        "formTitle": "Publicar no Instagram",
        "formDescription": "Preencha o conteudo final. Simular nao envia nada. Para envio real, selecione Publicar e marque CONFIRMO: o conteudo sera enviado a conta Instagram configurada nesta instalacao. Escolha foto, Story, Reels ou Carrossel. Pode montar video com as fotos em ordem e musica enviada. O catalogo de musicas do Instagram nao esta conectado. Stories exigem conta Business e nao exibem a legenda/hashtags deste formulario como texto na tela; inclua o texto na propria midia.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Descricao / legenda",
              "fieldName": "description",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Hashtags",
              "fieldName": "hashtags",
              "placeholder": "Separe por espacos ou virgulas"
            },
            {
              "fieldLabel": "Mencoes / tags",
              "fieldName": "tags",
              "placeholder": "@perfil1 @perfil2"
            },
            {
              "fieldLabel": "Imagens ou video",
              "fieldName": "media",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".jpg,.jpeg,.png,.mp4,.mov"
            },
            {
              "fieldLabel": "URL HTTPS da foto (opcional se anexou arquivo)",
              "fieldName": "image_url"
            },
            {
              "fieldLabel": "Formato da publicacao",
              "fieldName": "format",
              "fieldType": "dropdown",
              "defaultValue": "Automatico",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Automatico"
                  },
                  {
                    "option": "Foto no feed"
                  },
                  {
                    "option": "Story"
                  },
                  {
                    "option": "Reels"
                  },
                  {
                    "option": "Carrossel"
                  },
                  {
                    "option": "Carrossel em video (Reels)"
                  },
                  {
                    "option": "Carrossel em video (Story)"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Audio",
              "fieldName": "audio_mode",
              "fieldType": "dropdown",
              "defaultValue": "Manter audio original",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Manter audio original"
                  },
                  {
                    "option": "Sem som"
                  },
                  {
                    "option": "Musica enviada"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Musica (arquivo com direito de uso)",
              "fieldName": "music",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".mp3,.wav,.m4a,.aac,.ogg"
            },
            {
              "fieldLabel": "Segundos por imagem ao montar video",
              "fieldName": "seconds_per_image",
              "fieldType": "number",
              "defaultValue": "5"
            },
            {
              "fieldLabel": "Volume da musica (0 a 100)",
              "fieldName": "music_volume",
              "fieldType": "number",
              "defaultValue": "60"
            },
            {
              "fieldLabel": "Comecar musica em (segundos)",
              "fieldName": "music_start",
              "fieldType": "number",
              "defaultValue": "0"
            },
            {
              "fieldLabel": "Ordem dos arquivos (opcional)",
              "fieldName": "order",
              "placeholder": "Exemplo: 2,1,3. Vazio: ordem da selecao."
            },
            {
              "fieldLabel": "Modo",
              "fieldName": "mode",
              "fieldType": "dropdown",
              "defaultValue": "Simular",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Simular"
                  },
                  {
                    "option": "Publicar"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Confirmacao de publicacao",
              "fieldName": "confirmation",
              "fieldType": "checkbox",
              "fieldOptions": {
                "values": [
                  {
                    "option": "CONFIRMO"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "publicar-instagram",
          "buttonLabel": "Executar",
          "appendAttribution": false,
          "includeUserInOutput": false
        }
      },
      "webhookId": "manual-instagram"
    },
    {
      "id": "conversar-e-preparar",
      "name": "Preparar formulario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://editorial:8080/manual/prepare",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({session_id:$('Identificar formulario').first().json.sessionId,platform:'instagram',form:$('Identificar formulario').first().json,attachments:$json.attachments || []}) }}",
        "options": {
          "timeout": 900000
        }
      }
    },
    {
      "id": "tem-envios",
      "name": "Tem envios",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dispatch",
              "leftValue": "={{ $json.jobs.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "responder",
      "name": "Responder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        200
      ],
      "parameters": {
        "jsCode": "return [{json:{output:$input.first().json.output}}];"
      }
    },
    {
      "id": "preparar-envios",
      "name": "Preparar envios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "return $input.first().json.jobs.map(job=>({json:job}));"
      }
    },
    {
      "id": "chamar-publicador",
      "name": "Chamar publicador",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.workflow_id }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "reunir-resultados",
      "name": "Reunir resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const jobs=$('Preparar envios').all();const results=$input.all();if(jobs.length!==results.length) throw new Error('Numero inesperado de retornos; confira as execucoes antes de repetir');return [{json:{results:results.map((item,i)=>({job_id:jobs[i].json.job_id,result:item.json}))}}];"
      }
    },
    {
      "id": "registrar-resultados",
      "name": "Registrar resultados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://editorial:8080/results",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 90000
        }
      }
    },
    {
      "id": "separar-anexos",
      "name": "Separar anexos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        0
      ],
      "parameters": {
        "jsCode": "const item=$input.first(); const entries=Object.entries(item.binary || {}); if(!entries.length)return [{json:{has_files:false}}]; return entries.map(([key,file])=>({json:{has_files:true,name:file.fileName || 'arquivo.jpg'},binary:{data:file}}));"
      }
    },
    {
      "id": "recebeu-arquivos",
      "name": "Recebeu arquivos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        120,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-files",
              "leftValue": "={{ $json.has_files }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "guardar-anexo",
      "name": "Guardar anexo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        -220
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://editorial:8080/media/upload?session=' + encodeURIComponent($('Identificar formulario').first().json.sessionId) + '&name=' + encodeURIComponent($json.name) }}",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "reunir-anexos",
      "name": "Reunir anexos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -220
      ],
      "parameters": {
        "jsCode": "return [{json:{attachments:$input.all().map(item=>{if(!item.json.asset_id)throw new Error('Anexo nao foi salvo');return item.json.asset_id;})}}];"
      }
    },
    {
      "id": "identificar-formulario",
      "name": "Identificar formulario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        0
      ],
      "parameters": {
        "jsCode": "const i=$input.first();return [{json:{...i.json,sessionId:'manual-instagram-'+$execution.id},binary:i.binary}];"
      }
    },
    {
      "id": "resultado-do-formulario",
      "name": "Resultado do formulario",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.6,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "operation": "completion",
        "completionTitle": "Resultado da publicacao",
        "completionMessage": "={{ $json.output }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Separar anexos": {
