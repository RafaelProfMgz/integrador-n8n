{
  "name": "Meta - instagram - foto manual (dry-run)",
  "active": false,
  "nodes": [
    {
      "id": "inicio-manual",
      "name": "Inicio manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "conteudo",
      "name": "Conteudo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{json: {\"platform\": \"instagram\", \"dry_run\": true, \"approved\": false, \"caption\": \"Minha primeira publicacao de teste\", \"image_url\": \"https://example.com/imagem.jpg\"}}];"
      }
    },
    {
      "id": "validar",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json;\nif (typeof p.dry_run !== 'boolean') throw new Error('dry_run deve ser booleano');\nif (!['facebook', 'instagram'].includes(p.platform)) throw new Error('Plataforma invalida');\nif (typeof p.caption !== 'string' || !p.caption.trim()) throw new Error('Legenda obrigatoria');\nif (p.platform === 'instagram' && p.caption.length > 2200) throw new Error('Legenda Instagram excede 2200 caracteres');\nif (typeof p.image_url !== 'string' || !/^https:\\/\\/[^\\s/]+\\/\\S+$/.test(p.image_url)) throw new Error('Informe URL HTTPS publica da imagem');\nif (!p.dry_run) {\n  if (p.approved !== true) throw new Error('Aprovacao explicita necessaria');\n  const account = p.platform === 'facebook' ? $env.META_FACEBOOK_PAGE_ID : $env.META_INSTAGRAM_ACCOUNT_ID;\n  const token = p.platform === 'facebook' ? $env.META_FACEBOOK_PAGE_ACCESS_TOKEN : $env.META_INSTAGRAM_ACCESS_TOKEN;\n  if (!/^\\d+$/.test(account || '')) throw new Error('Configure o ID Meta no .env');\n  if (!/^v\\d+\\.\\d+$/.test($env.META_GRAPH_VERSION || '')) throw new Error('Configure META_GRAPH_VERSION no .env');\n  if (!token || !token.trim()) throw new Error('Configure o access token Meta no .env');\n  if (p.image_url.includes('example.com')) throw new Error('Substitua a imagem de exemplo');\n}\nreturn [{json: p}];"
      }
    },
    {
      "id": "simular",
      "name": "Simular",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dry-run",
              "leftValue": "={{ $json.dry_run }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "previa-sem-publicar",
      "name": "Previa sem publicar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -140
      ],
      "parameters": {
        "jsCode": "return [{json: {status: 'dry_run', content: $input.first().json, message: 'Nenhuma chamada externa realizada'}}];"
      }
    },
    {
      "id": "criar-container-instagram",
      "name": "Criar container Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/' + $env.META_GRAPH_VERSION + '/' + $env.META_INSTAGRAM_ACCOUNT_ID + '/media' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.META_INSTAGRAM_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $('Validar').first().json.image_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Validar').first().json.caption }}"
            }
          ]
        }
      },
      "retryOnFail": false
    },
    {
      "id": "esperar-processamento",
      "name": "Esperar processamento",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1120,
        120
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      }
    },
    {
      "id": "consultar-container",
      "name": "Consultar container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://graph.facebook.com/' + $env.META_GRAPH_VERSION + '/' + $('Criar container Instagram').first().json.id }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.META_INSTAGRAM_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status_code,status"
            }
          ]
        }
      },
      "retryOnFail": false
    },
    {
      "id": "exigir-finished",
      "name": "Exigir FINISHED",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        120
      ],
      "parameters": {
        "jsCode": "const status = $input.first().json; const id = $('Criar container Instagram').first().json.id; if (status.status_code !== 'FINISHED') throw new Error('Container ' + id + ': ' + status.status_code + '. Consulte este ID e reconcilie antes de repetir; nao recrie automaticamente.'); return [{json: {creation_id: id}}];"
      }
    },
    {
      "id": "publicar-instagram",
      "name": "Publicar Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/' + $env.META_GRAPH_VERSION + '/' + $env.META_INSTAGRAM_ACCOUNT_ID + '/media_publish' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.META_INSTAGRAM_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.creation_id }}"
            }
          ]
        }
      },
      "retryOnFail": false
    }
  ],
