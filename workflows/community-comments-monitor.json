{
  "name": "Comunidade livros - monitorar comentarios recentes",
  "active": false,
  "nodes": [
    {
      "id": "verificar-agora",
      "name": "Verificar agora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "a-cada-15-minutos",
      "name": "A cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "buscar-e-classificar-comentarios",
      "name": "Buscar e classificar comentarios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://community:8080/run",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}"
      },
      "retryOnFail": false
    },
    {
      "id": "resumo-do-ciclo",
      "name": "Resumo do ciclo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:$input.first().json}];"
      }
    }
  ],
  "connections": {
    "Verificar agora": {
      "main": [
        [
          {
            "node": "Buscar e classificar comentarios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A cada 15 minutos": {
      "main": [
        [
          {
            "node": "Buscar e classificar comentarios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar e classificar comentarios": {
      "main": [
        [
          {
            "node": "Resumo do ciclo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Cuiaba",
    "saveManualExecutions": true
  },
  "pinData": {},
  "tags": []
}
