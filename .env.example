# Versao fixada; revisar notas oficiais antes de atualizar.
N8N_VERSION=2.47.3
N8N_PORT=5680
TZ=America/Cuiaba
POSTGRES_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
# HTTP local. Em producao: HTTPS + proxy, cookie seguro e URL publica.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5680/
WEBHOOK_URL=http://localhost:5680/
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false

# Meta: configuracao e segredos somente neste arquivo local.
# App ID/Secret sao usados na obtencao/renovacao de tokens, nao nos POSTs destes modelos.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=

# X: token OAuth 2.0 de usuario (nao app-only Bearer Token).
X_USER_ID=
X_OAUTH2_ACCESS_TOKEN=

# Chatbot editorial: chave OpenAI e configuracao local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHATBOT_PUBLISH_ENABLED=false
N8N_PUBLISH_FACEBOOK_WORKFLOW_ID=
N8N_PUBLISH_INSTAGRAM_WORKFLOW_ID=
N8N_PUBLISH_X_WORKFLOW_ID=
N8N_EDITORIAL_CHAT_WORKFLOW_ID=

# Subagente de imagem: URL publica opcional da rota de arquivos.
OPENAI_IMAGE_MODEL=gpt-image-1.5
IMAGE_PUBLIC_BASE_URL=
N8N_IMAGE_AGENT_WORKFLOW_ID=

# Comunidade de livros: leitura, revisao e respostas a comentarios.
COMMUNITY_NAME=Comunidade de livros
COMMUNITY_SITE_URL=
COMMENTS_READ_ENABLED=false
COMMENTS_SEND_ENABLED=false
COMMENTS_MODE=review
COMMENTS_X_REPLY_ENABLED=false
COMMENTS_PLATFORMS=instagram
COMMENTS_POST_DAYS=30
COMMENTS_LOOKBACK_DAYS=7
COMMENTS_MAX_POSTS=10
COMMENTS_MAX_COMMENTS=20
COMMENTS_RUN_REPLY_LIMIT=3
COMMENTS_DAILY_LIMIT=20
COMMENTS_AUTHOR_DAILY_LIMIT=2
N8N_COMMENTS_MONITOR_WORKFLOW_ID=
N8N_COMMENTS_REVIEW_WORKFLOW_ID=
N8N_COMMENTS_APPROVE_WORKFLOW_ID=
N8N_COMMENTS_SKILLS_WORKFLOW_ID=
